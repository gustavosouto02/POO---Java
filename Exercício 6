import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.Locale;

public class DateFormat {
    private int dia;
    private int mes; 
    private int ano;

    // Construtor 1: MM/DD/YYYY
    public DateFormat(int mes, int dia, int ano) {
        this.mes = mes;
        this.dia = dia;
        this.ano = ano;
    }

    // Construtor 2: "Month Day"
    public DateFormat(String dateString, int ano) {
        try {
            String[] parts = dateString.split(" ");
            this.mes = getMonthNumber(parts[0]);
            this.dia = Integer.parseInt(parts[1].replace(",", ""));
            this.ano = ano;
        } catch (Exception e) {
            System.out.println("Data inválida.");
        }
    }

    // Construtor 3: DDD YYYY
    public DateFormat(int diaDoAno, int ano) {
        Calendar calendar = Calendar.getInstance();
        calendar.set(Calendar.YEAR, ano);
        calendar.set(Calendar.DAY_OF_YEAR, diaDoAno);
        this.dia = calendar.get(Calendar.DAY_OF_MONTH);
        this.mes = calendar.get(Calendar.MONTH) + 1; // Meses começam em 0
        this.ano = calendar.get(Calendar.YEAR);
    }

    // Método para imprimir a data em formato MM/DD/YYYY
    public String toMMDDYYYY() {
        return String.format("%02d/%02d/%04d", mes, dia, ano);
    }

    // Método para imprimir a data no formato "Month Day, Year"
    public String toStringLongFormat() {
        String monthString = new SimpleDateFormat("MMMM", Locale.ENGLISH).format(getDate());
        return String.format("%s %d, %d", monthString, dia, ano);
    }

    // Método para imprimir a data em formato "DDD YYYY"
    public String toDDDYYYY() {
        Calendar calendar = Calendar.getInstance();
        calendar.set(ano, mes - 1, dia);
        int dayOfYear = calendar.get(Calendar.DAY_OF_YEAR);
        return String.format("%03d %d", dayOfYear, ano);
    }

    // Método auxiliar para converter mês por extenso em número
    private int getMonthNumber(String monthName) {
        try {
            SimpleDateFormat sdf = new SimpleDateFormat("MMMM", Locale.ENGLISH);
            Date date = sdf.parse(monthName);
            Calendar cal = Calendar.getInstance();
            cal.setTime(date);
            return cal.get(Calendar.MONTH) + 1; // Meses começam em 0
        } catch (Exception e) {
            return -1; // Retorna -1 em caso de erro
        }
    }

    // Método auxiliar para obter a data como objeto Date
    private Date getDate() {
        Calendar calendar = Calendar.getInstance();
        calendar.set(ano, mes - 1, dia);
        return calendar.getTime();
    }
}

