import java.util.Scanner;

public class TicTacToe {
    public enum Cell {
        X, O, EMPTY
    }

    private final Cell[][] board; // 3x3

    public TicTacToe() {
        board = new Cell[3][3];
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = Cell.EMPTY; // Inicializa o tabuleiro com EMPTY
            }
        }
    }

    // Método para imprimir o tabuleiro
    public void printBoard() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(board[i][j] + "\t");
            }
            System.out.println();
        }
    }

    // Método para verificar se um jogador ganhou
    public boolean checarVitoria(Cell player) {
        for (int i = 0; i < 3; i++) {
            if ((board[i][0] == player && board[i][1] == player && board[i][2] == player) ||
                (board[0][i] == player && board[1][i] == player && board[2][i] == player)) {
                return true;
            }
        }
        return (board[0][0] == player && board[1][1] == player && board[2][2] == player) ||
               (board[0][2] == player && board[1][1] == player && board[2][0] == player);
    }

    // Método para verificar se o tabuleiro está cheio
    public boolean estaCheio() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (board[i][j] == Cell.EMPTY) {
                    return false;
                }
            }
        }
        return true; // Tabuleiro está cheio
    }

    // Método para jogar
    public boolean makeMove(int row, int col, Cell player) {
        if (row >= 0 && row < 3 && col >= 0 && col < 3 && board[row][col] == Cell.EMPTY) {
            board[row][col] = player;
            return true;
        }
        return false; // Movimento inválido
    }

    // Método principal para executar o jogo
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        TicTacToe game = new TicTacToe();
        Cell currentPlayer = Cell.X; // Primeiro jogador é X

        while (true) {
            game.printBoard();
            System.out.printf("Jogador %s, faça sua jogada (linha e coluna): ", currentPlayer);
            int row = scanner.nextInt();
            int col = scanner.nextInt();

            if (game.makeMove(row, col, currentPlayer)) {
                if (game.checarVitoria(currentPlayer)) {
                    game.printBoard();
                    System.out.printf("Parabéns, jogador %s! Você ganhou!%n", currentPlayer);
                    break;
                }
                if (game.estaCheio()) {
                    game.printBoard();
                    System.out.println("Empate!");
                    break;
                }
                currentPlayer = (currentPlayer == Cell.X) ? Cell.O : Cell.X; // Alterna o jogador
            } else {
                System.out.println("Movimento inválido. Tente novamente.");
            }
        }
        scanner.close();
    }
}
