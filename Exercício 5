//FatorialCalculator.java
public class FatorialCalculator{
    public static long calcularFatorial(int num) throws NegativeNumberException{
        if(num < 0 ){
            throw new NegativeNumberException("O numero não pode ser negativo.");
        }
        if(num == 0 || num == 1){
            return 1;
        }
        return num * calcularFatorial(num - 1);
    }
}
